# ======================================================
#  Version variables:
# ======================================================
SET(@PROJECT_NAME@_VERSION @PROJECT_VERSION@)
SET(@PROJECT_NAME@_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@)
SET(@PROJECT_NAME@_VERSION_MINOR  @PROJECT_VERSION_MINOR@)
SET(@PROJECT_NAME@_VERSION_PATCH  @PROJECT_VERSION_PATCH@)

@PACKAGE_INIT@

# Snapshot the prefix before any dependency is looked up.
#
# PACKAGE_PREFIX_DIR is a plain variable in the *consumer's* scope, and every
# installed package's config recomputes it from its own location. The
# find_dependency() calls below therefore overwrite it: find_dependency(oatpp)
# runs /usr/local/lib/cmake/oatpp-1.4.0/oatppConfig.cmake, which resets it to
# /usr/local, and every path this file computes afterwards points into the oatpp
# prefix instead of this package's.
#
# Measured 2026-10-31 by building `boxes` against a staged install:
#   toffy_oatpp_INCLUDE_DIRS = /usr/local/include/
#   toffy_oatpp_LIBRARIES    = /usr/local/lib/libtoffy_oatpp.so   (not there)
# It configures — set_and_check only asks whether the directory exists, and
# /usr/local/include does — and fails at link. Two reasons it stayed hidden: the
# CI consumer cell builds toffy_oatpp from source against a staged toffy and
# never installs it, so Config.cmake.in is not on that path at all; and an
# install into /usr/local, which is where oatpp lives, makes the wrong prefix
# the right one by accident. Any staged or relocated install gets it.
set(TOFFY_OATPP_PACKAGE_PREFIX "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)

################################################################################
# Dependencies. Without these the dependency was not transitive at all: every
# consumer had to repeat find_package(toffy <ver>) by hand, and did so at versions
# that drifted from what this library was actually built against. The versions below
# are substituted from the build that produced this file -- with toffy's full-version
# SOVERSION, a different toffy is not merely a different version but a different
# library, so refusing it here is the cheaper error.
################################################################################

find_dependency(toffy @toffy_VERSION@)
find_dependency(oatpp @oatpp_VERSION@)
find_dependency(oatpp-swagger @oatpp-swagger_VERSION@)

set(@PROJECT_NAME@_DEFINITIONS @DEFINITIONS@)
#add_definitions( ${@PROJECT_NAME@_DEFINITIONS} )

#####################################################################################
# Feature flags of this build — mirrors toffy's toffy_WITH_BTA, same reasoning.
#####################################################################################
# Always substituted, 0 or 1: a consumer must be able to tell "built without BTA"
# from "built before the flag existed". The compile definition
# TOFFYOATPP_WITH_BTA travels on the imported target, so `#if` in an application
# reads this library; the variables here are for CMake-level decisions, and
#   find_package(toffy_oatpp 0.1 REQUIRED COMPONENTS BTA)
# is how an app that cannot work without the camera endpoints says so.
set(@PROJECT_NAME@_WITH_BTA @TOFFYOATPP_WITH_BTA@)
set(@PROJECT_NAME@_BTA_FOUND @TOFFYOATPP_WITH_BTA@)

message(STATUS "Found @PROJECT_NAME@ ${@PROJECT_NAME@_VERSION}: BTA endpoints ${@PROJECT_NAME@_WITH_BTA}")

################################################################################
# Include directories to add to the user project:
################################################################################

get_filename_component(@PROJECT_NAME@_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
#if (MSVC)
#set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/include/")
set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "${TOFFY_OATPP_PACKAGE_PREFIX}/include/")
#else()
#set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/@INSTALL_CMAKE_DIR@")
#set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@INSTALL_CMAKE_DIR@")
#endif()

#set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@PROJECT_SOURCE_DIR@" "@PROJECT_BINARY_DIR@" "@CMAKE_INSTALL_PREFIX@/@INSTALL_CMAKE_DIR@")
#set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@PROJECT_SOURCE_DIR@" "@PROJECT_BINARY_DIR@" "${_@PROJECT_NAME@_rootdir}/@INSTALL_CMAKE_DIR@")
include_directories(${@PROJECT_NAME@_INCLUDE_DIRS})

################################################################################
# Link directories: none. @PROJECT_NAME@_LIB_DIR was never set, so this line
# expanded to LINK_DIRECTORIES(<nothing> <oatpp dirs>) and polluted the directory
# property of every consumer that included this config. The exported targets in
# @PROJECT_NAME@Targets.cmake carry absolute paths, which is the mechanism.
################################################################################


# Our library dependencies (contains definitions for IMPORTED targets)
if(NOT TARGET @PROJECT_NAME@ AND NOT @PROJECT_NAME@_BINARY_DIR)
  include("${@PROJECT_NAME@_CMAKE_DIR}/@PROJECT_NAME@Targets.cmake")
endif()

# Some additional settings are required if project is built as static libs
set(@PROJECT_NAME@_SHARED @BUILD_SHARED_LIBS@)

################################################################################
# Link libraries:
################################################################################
if (MSVC)
    #set(@PROJECT_NAME@_LIBRARIES_RELEASE "@CMAKE_INSTALL_PREFIX@/@INSTALL_BIN_DIR@/@PROJECT_NAME@@CMAKE_SHARED_LIBRARY_SUFFIX@")
    #set(@PROJECT_NAME@_LIBRARIES_DEBUG "@CMAKE_INSTALL_PREFIX@/@INSTALL_BIN_DIR@/@PROJECT_NAME@@CMAKE_DEBUG_POSTFIX@@CMAKE_SHARED_LIBRARY_SUFFIX@")

    #set(@PROJECT_NAME@_LIBRARIES_RELEASE "${_@PROJECT_NAME@_rootdir}/@INSTALL_BIN_DIR@/@PROJECT_NAME@@CMAKE_SHARED_LIBRARY_SUFFIX@")
    #set(@PROJECT_NAME@_LIBRARIES_DEBUG "${_@PROJECT_NAME@_rootdir}/@INSTALL_BIN_DIR@/@PROJECT_NAME@@CMAKE_DEBUG_POSTFIX@@CMAKE_SHARED_LIBRARY_SUFFIX@")

    #set(@PROJECT_NAME@_LIBRARIES_RELEASE "@CMAKE_INSTALL_PREFIX@/@INSTALL_LIB_DIR@/@PROJECT_NAME@.lib")
    #set(@PROJECT_NAME@_LIBRARIES_DEBUG "@CMAKE_INSTALL_PREFIX@/@INSTALL_LIB_DIR@/@PROJECT_NAME@@CMAKE_DEBUG_POSTFIX@.lib")
    set(@PROJECT_NAME@_LIBRARIES_RELEASE "${TOFFY_OATPP_PACKAGE_PREFIX}/@INSTALL_LIB_DIR@/@PROJECT_NAME@.lib")
    set(@PROJECT_NAME@_LIBRARIES_DEBUG "${TOFFY_OATPP_PACKAGE_PREFIX}/@INSTALL_LIB_DIR@/@PROJECT_NAME@@CMAKE_DEBUG_POSTFIX@.lib")
else()
    #set(@PROJECT_NAME@_LIBRARIES_RELEASE "@CMAKE_INSTALL_PREFIX@/@INSTALL_LIB_DIR@/lib@PROJECT_NAME@@CMAKE_SHARED_LIBRARY_SUFFIX@")
    #set(@PROJECT_NAME@_LIBRARIES_DEBUG "@CMAKE_INSTALL_PREFIX@/@INSTALL_LIB_DIR@/lib@PROJECT_NAME@@CMAKE_DEBUG_POSTFIX@@CMAKE_SHARED_LIBRARY_SUFFIX@")
    set(@PROJECT_NAME@_LIBRARIES_RELEASE "${TOFFY_OATPP_PACKAGE_PREFIX}/@INSTALL_LIB_DIR@/lib@PROJECT_NAME@@CMAKE_SHARED_LIBRARY_SUFFIX@")
    set(@PROJECT_NAME@_LIBRARIES_DEBUG "${TOFFY_OATPP_PACKAGE_PREFIX}/@INSTALL_LIB_DIR@/lib@PROJECT_NAME@@CMAKE_DEBUG_POSTFIX@@CMAKE_SHARED_LIBRARY_SUFFIX@")
endif()
if(@CMAKE_BUILD_TYPE@ MATCHES Debug)
    list(APPEND @PROJECT_NAME@_LIBRARIES ${@PROJECT_NAME@_LIBRARIES_DEBUG})
else()
    list(APPEND @PROJECT_NAME@_LIBRARIES ${@PROJECT_NAME@_LIBRARIES_RELEASE})
endif()

#set(@PROJECT_NAME@_EXECUTABLE bar)

check_required_components("@PROJECT_NAME@")
